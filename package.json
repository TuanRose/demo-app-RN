{
  "name": "demo_app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:sim": "react-native run-ios --simulator \"iPhone 17 Pro Max\"",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "deploy:ios:beta": "bundle exec fastlane ios beta",
    "deploy:ios:build": "bundle exec fastlane ios build_only",
    "deploy:android:beta": "bundle exec fastlane android beta",
    "deploy:android:build": "bundle exec fastlane android build_only",
    "deploy:lanes": "bundle exec fastlane lanes"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@op-engineering/op-sqlite": "^15.2.12",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/new-app-screen": "0.85.2",
    "@react-navigation/bottom-tabs": "^7.15.12",
    "@react-navigation/native": "^7.2.3",
    "@react-navigation/native-stack": "^7.14.13",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-query": "^5.100.9",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-bootsplash": "^7.3.1",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.24.0",
    "react-redux": "^9.2.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "AppModulesSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.demo_app.specs"
    },
    "ios": {
      "modulesProvider": {
        "NativeDeviceBattery": "RCTNativeDeviceBattery"
      }
    }
  }
}
