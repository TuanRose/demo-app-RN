# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  fastlane/.env.default — NON-SECRET DEFAULTS, SAFE TO COMMIT
#
#  Fastlane loads this file automatically.
#  Values here can be overridden by fastlane/.env
#  or by CI environment variables (GitHub Actions Secrets).
#
#  Only put values here that are:
#  - Not sensitive (no passwords, keys, or tokens)
#  - Rarely change across environments
#  - Safe to share with the whole team via git
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Default rollout percentage for Android production release
# Start at 10% — increase gradually after confirming stable
ROLLOUT_PERCENTAGE=0.1

# Default version (overridden by the bump_version lane or CI)
APP_VERSION=1.0.0
